{
  "name": "@tassili/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "start": "nx serve template",
    "storybook": "nx storybook docs",
    "build": "nx run-many -t build",
    "build:storybook": "nx build-storybook docs",
    "test": "nx run-many -t test",
    "e2e": "nx e2e template-e2e",
    "lint": "nx run-many -t lint && pnpm lint:styles",
    "lint:styles": "node tools/scripts/check-styles.mjs",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "license:check": "node tools/scripts/licenses.mjs",
    "license:write": "node tools/scripts/licenses.mjs --write",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm license:check && pnpm build:storybook",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only && pnpm license:write",
    "release": "nx run-many -t build -p ui tokens && changeset publish",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@angular-devkit/architect": "~0.2202.1",
    "@angular-devkit/build-angular": "~22.2.1",
    "@angular-devkit/core": "~22.2.1",
    "@angular-devkit/schematics": "~22.2.1",
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "@angular/language-service": "~22.2.1",
    "@axe-core/playwright": "^4.13.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@nx/angular": "23.2.1",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/storybook": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.63.0",
    "@schematics/angular": "~22.2.1",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/angular": "^10.6.1",
    "@swc/helpers": "~0.5.18",
    "@tailwindcss/postcss": "^4.3.3",
    "@tassili/tokens": "workspace:*",
    "@tassili/ui": "workspace:*",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@typescript-eslint/utils": "^8.71.1",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-playwright": "^2.12.1",
    "jsdom": "^30.1.2",
    "jsonc-eslint-parser": "^2.1.0",
    "ng-packagr": "~22.2.4",
    "nx": "23.2.1",
    "postcss": "^8.4.5",
    "prettier": "^3.9.9",
    "remark-gfm": "^4.0.1",
    "simple-git-hooks": "^2.14.0",
    "storybook": "^10.6.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.1",
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@lucide/angular": "^1.52.0",
    "@spartan-ng/brain": "^1.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.7.0"
  },
  "nx": {
    "includedScripts": []
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  },
  "description": "Tassili design system: Angular UI library, design tokens and starter template.",
  "author": "Okba Bouziane"
}
